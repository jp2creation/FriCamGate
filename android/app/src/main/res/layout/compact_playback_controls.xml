<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <ImageButton android:id="@id/exo_rew" android:layout_width="40dp" android:layout_height="48dp"
        android:padding="10dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/exo_styled_controls_rewind" android:scaleType="centerInside" />
    <ImageButton android:id="@id/exo_play_pause" android:layout_width="40dp" android:layout_height="48dp"
        android:padding="10dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside" />
    <ImageButton android:id="@id/exo_ffwd" android:layout_width="40dp" android:layout_height="48dp"
        android:padding="10dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/exo_styled_controls_fastforward" android:scaleType="centerInside" />
    <TextView android:id="@id/exo_position" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="10sp" android:fontFamily="sans-serif" android:paddingStart="4dp" />
    <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="0dp"
        android:layout_height="48dp" android:layout_weight="1" app:bar_height="2dp"
        app:scrubber_enabled_size="8dp" app:scrubber_dragged_size="12dp" />
    <TextView android:id="@id/exo_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="10sp" android:fontFamily="sans-serif" />
</LinearLayout>
